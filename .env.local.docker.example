# .env.local.docker.example — template per docker-compose.local.yml
#
# COPIA in .env.local.docker (gitignored) e lascia inalterati i
# valori dev di default; non servono secret reali per girare lo stack
# locale. NON committare .env.local.docker.
#
# Uso:
#   cp .env.local.docker.example .env.local.docker
#   ./scripts/local/up.sh   # bash
#   .\scripts\local\up.ps1   # PowerShell

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# SECRET_KEY: dev-only. Mai usare questo valore in staging/prod.
DJANGO_SECRET_KEY=django-insecure-local-docker-only-do-not-use-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Locale / timezone
LANGUAGE_CODE=it
TIME_ZONE=Europe/Rome

# Branding
SITE_NAME=Simulatore Risarcimenti Studio Legale Badrane (LOCAL)
SITE_DOMAIN=localhost:8000
PARENT_SITE_URL=https://international.studiolegalebadrane.it/

# ---------------------------------------------------------------------------
# Postgres (servizio `db` del compose locale)
# ---------------------------------------------------------------------------
POSTGRES_DB=badrane_local
POSTGRES_USER=badrane
POSTGRES_PASSWORD=badrane_local_dev

# DATABASE_URL viene già derivata in compose, ma se serve override
# manuale (es. puntare a un Postgres host esterno) basta valorizzare
# qui:
DATABASE_URL=postgres://badrane:badrane_local_dev@db:5432/badrane_local

# ---------------------------------------------------------------------------
# Redis (servizio `redis` del compose locale)
# Predisposto per Celery futuro. Non utilizzato in pass 6.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Pass 1 — public POST rate-limit (cache-based)
# ---------------------------------------------------------------------------
PUBLIC_POST_RATE_LIMIT_ENABLED=True
# PUBLIC_POST_RATE_LIMIT_WINDOW_SECONDS=3600
# PUBLIC_POST_RATE_LIMIT_MAX_ATTEMPTS=20

# ---------------------------------------------------------------------------
# Pass 2 — email notifica Lead
# In dev il backend default è `console` se DEBUG=True.
# Per ricevere effettivamente email Studio: configurare SMTP backend
# + LEAD_NOTIFICATION_TO_EMAILS=studio@example.test
# ---------------------------------------------------------------------------
LEAD_NOTIFICATION_ENABLED=False
LEAD_NOTIFICATION_TO_EMAILS=
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=no-reply@badrane.local
# DJANGO_EMAIL_SUBJECT_PREFIX=[Badrane LegalTech]

# ---------------------------------------------------------------------------
# Pass 3 — Sentry (DSN vuoto = no-op)
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=False

# ---------------------------------------------------------------------------
# Pass 5 — admin MFA
# False di default in dev: il guard è no-op.
# Per testare il flusso MFA in locale: True + setup TOTP via shell
# (vedi LOCAL_PRODUCT_HARDENING_PASS5_MFA_ADMIN.md §5).
# ---------------------------------------------------------------------------
ADMIN_MFA_REQUIRED=False
