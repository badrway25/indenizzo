secrets/
*.pem
*.key

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lighthouse CI scratch (P1-SEO-2 + P2-SEO-1). Reports we want to
# keep live in `docs/qa/lighthouse-baseline/` (desktop) and
# `docs/qa/lighthouse-mobile-baseline/` (mobile); the
# `.lighthouseci*/` dirs are the per-run scratch space.
.lighthouseci/
.lighthouseci-mobile/

# Per-run hygiene reports (P1-LEG-2). The script writes JSON here on
# demand; nothing in `artifacts/` is canonical. Keep findings in PR
# descriptions or fold them into `docs/qa/` if persistent.
artifacts/

# Pre-compressed static companions (P2-PERF-1). `manage.py precompress_static`
# generates `<file>.gz` next to each `.css`/`.js`/`.svg` in `static/` so
# WhiteNoise can serve compressed responses to clients with
# `Accept-Encoding: gzip`. The companions are build artefacts: source
# files are the truth, .gz are derived. Regenerate locally with
# `python manage.py precompress_static` (or via the Lighthouse runner
# pre-step). In production, `collectstatic` with
# `CompressedStaticFilesStorage` does the same thing.
static/**/*.gz
static/**/*.br

# IDE
.vscode/*
!.vscode/settings.json
.idea/

# Claude local/private
.claude/settings.local.json
.claude/agent-memory-local/

# OS
.DS_Store
Thumbs.db

# Legal data — PDFs ufficiali, CSV di estrazione, log audit (vedi
# legal_data/README.md). Solo i README/template restano in repository:
# i materiali legali ufficiali non vanno committati.
legal_data/sources/**/*.pdf
legal_data/sources/**/*.PDF
legal_data/sources/**/*.csv
legal_data/sources/**/*.xlsx
legal_data/sources/**/*.xls
legal_data/sources/**/*.docx
# HTML scaricati dai download command — voluminosi, contenuto esterno.
# Solo il manifest (JSON) e i README restano committabili.
legal_data/sources/**/*.html
legal_data/sources/**/*.htm
legal_data/sources/**/*.HTML
legal_data/sources/**/extraction_notes.md
# OCR spike outputs (rendered PNG, raw OCR text, spike summary) — gitignored
# perché candidate read-only e voluminosi.
legal_data/sources/**/ocr_spike/
# Eccezione: i template di checklist review non contengono dati legali
# (solo header + righe pre-popolate con status=pending) e sono
# committabili come strumento operativo per lo Studio.
!legal_data/sources/*/review/
!legal_data/sources/*/review/*_template.csv
legal_data/extraction_logs/*.json
legal_data/extraction_logs/*.log
legal_data/exports/*.json

# Local runtime/dev artifacts
backups/
.playwright-mcp/

# Pexels image cache — runtime download (vedi
# docs/architecture/PEXELS_IMAGE_INTEGRATION.md). NESSUN file Pexels
# va committato: per licenza dobbiamo scaricarli su istanze "online"
# e non distribuirli via repo. Il manifest pexels_manifest.json è
# generato dal comando `manage.py fetch_pexels_site_images` e resta
# locale. `media/` è già gitignored sopra, queste righe sono uno
# guard esplicito per chiunque sposti la cache fuori da `media/`.
**/pexels_manifest.json
**/pexels/*.jpg
**/pexels/*.jpeg
**/pexels/*.png
**/pexels/*.webp

p3*_*.jpeg
p3*_*.png

# P4x QA screenshots (never commit)
p4*_*.jpeg
p4*.jpeg
p4*_*.png
