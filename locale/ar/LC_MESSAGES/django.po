msgstr "اطلب مراجعة الميراث المغربي"

msgid "Request Tunisian inheritance review"
msgstr "اطلب مراجعة الميراث التونسي"

msgid "Legal basis"
msgstr "الأساس القانوني"

msgid ""
"Approved sources have been validated by the Studio's legal team. Sources "
"marked as \"needs review\" are catalogued but cannot drive any public "
