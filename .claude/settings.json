{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(python --version)",
      "Bash(py --version)",
      "Bash(python manage.py check*)",
      "Bash(python manage.py test*)",
      "Bash(pytest*)",
      "Bash(ruff check*)",
      "Bash(black --check*)",
      "Bash(python manage.py makemigrations*)",
      "Bash(python manage.py migrate*)",
      "Bash(python manage.py runserver*)"
    ],
    "ask": [
      "Bash(python -m pip install*)",
      "Bash(pip install*)",
      "Bash(npm install*)",
      "Bash(npm run*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./media/private/**)",
      "Bash(rm -rf*)",
      "Bash(del /s*)",
      "Bash(format*)",
      "Bash(curl * | *)",
      "Bash(irm * | iex*)"
    ]
  }
}
