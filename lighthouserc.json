{
  "ci": {
    "collect": {
      "//": "Public, indexable URLs only. The concrete wizard pages (e.g. /wizard/it/road-accident/) are noindex by design and Lighthouse scores them low for SEO; they are not in the gating set.",
      "url": [
        "http://127.0.0.1:8000/",
        "http://127.0.0.1:8000/contact/",
        "http://127.0.0.1:8000/wizard/",
        "http://127.0.0.1:8000/privacy/",
        "http://127.0.0.1:8000/disclaimer/",
        "http://127.0.0.1:8000/countries/",
        "http://127.0.0.1:8000/case-types/",
        "http://127.0.0.1:8000/ar/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "skipAudits": [
          "uses-http2",
          "is-on-https",
          "redirects-http",
          "uses-long-cache-ttl",
          "canonical"
        ]
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.80 }],
        "categories:accessibility": ["error", { "minScore": 0.90 }],
        "categories:best-practices": ["error", { "minScore": 0.90 }],
        "categories:seo": ["error", { "minScore": 0.90 }],

        "is-on-https": "off",
        "redirects-http": "off",
        "uses-http2": "off",
        "uses-long-cache-ttl": "off",
        "canonical": "off",

        "color-contrast": ["warn", {}],
        "valid-source-maps": "off",
        "errors-in-console": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
